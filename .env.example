# Copy to .env (local / docker compose) or set these in your hosting dashboard. NEVER commit the real .env file.
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=put-a-long-random-string-here
DJANGO_DEBUG=0                       # local development with a .env file: use 1
DJANGO_ALLOWED_HOSTS=your-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- docker compose only (docker-compose.yml refuses to start while these are missing)
POSTGRES_PASSWORD=use-letters-and-digits-only
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=choose-a-strong-password

# --- hardening (all optional)
# DJANGO_ADMIN_URL=my-private-admin-path/      # move the admin away from /admin/
# DJANGO_ADMIN_ALLOWED_IPS=203.0.113.5          # comma separated; empty = any IP (a staff login is always required)
# DJANGO_TRUSTED_PROXIES=1                      # number of reverse proxies in front of the app (see docs/SECURITY.md)
# REDIS_URL=redis://host:6379/0                 # share rate-limit counters between workers
# DJANGO_DB_SSLMODE=require                     # for a PostgreSQL reached over the internet
# DJANGO_HSTS_SECONDS=2592000
# CONTACT_EMAIL=you@example.com
# SITE_LAST_UPDATED=13 October 2026
# DJANGO_SECURE_SSL=0                           # only for plain http (e.g. local Docker)
# DJANGO_TIME_ZONE=Asia/Kolkata
# DJANGO_LOG_LEVEL=INFO
# SKIP_TRAIN=1                                  # keep the committed model files in build.sh
